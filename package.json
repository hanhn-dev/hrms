{
  "name": "with-npm",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/integrations/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "inspect:az": "npm run build --workspace=apps/az-mcp && npx @modelcontextprotocol/inspector node --env-file=./apps/az-mcp/.env ./apps/az-mcp/dist/index.js",
    "inspect:db": "npm run build --workspace=apps/db-mcp && npx @modelcontextprotocol/inspector node --env-file=./apps/db-mcp/.env ./apps/db-mcp/dist/index.js",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "postinstall": "patch-package && node scripts/fix-next-postcss.mjs && npm dedupe --ignore-scripts",
    "backstage": "npm run dev --workspace=apps/backstage"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "tsdown": "0.22.14",
    "turbo": "^2.10.8"
  },
  "overrides": {
    "ajv-formats": {
      "ajv": "^8.17.1"
    },
    "eslint": {
      "ajv": "^6.15.0"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.15.0"
    },
    "zod": "4.4.3",
    "next": {
      "postcss": "^8.5.14"
    }
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.18.0"
  }
}
