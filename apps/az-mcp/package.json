{
  "name": "az-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsdown",
    "build:standalone": "tsdown --config tsdown.standalone.config.ts",
    "pack:standalone": "npm run build:standalone && node scripts/pack-standalone.mjs",
    "start": "node --env-file=.env dist/index.js",
    "start:standalone": "node --env-file=.env standalone/dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node --env-file=.env dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hrms/azure-devops": "*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hrms/eslint-config": "*",
    "@hrms/typescript-config": "*",
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
