{
  "extends": "@hrms/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strictNullChecks": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["vite/client", "chrome", "vitest/globals"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "manifest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
