# Auth.js secret (required). Generate with: openssl rand -base64 32
AUTH_SECRET=

# Microsoft Entra ID (required for Sign in / Edit / Admin review of guides)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Local-only mock login for docs. Never set NODE_ENV=production with these.
# BACKSTAGE_DEV_AUTH=1
# BACKSTAGE_DEV_ADMIN=1
# BACKSTAGE_DEV_NAME=Local Admin

# --- Operator console (/features) ---
# Local root admin. Never enable this as the only auth in production.
TROUBLESHOOTER_ADMIN_USERNAME=admin
TROUBLESHOOTER_ADMIN_PASSWORD=

# TUsers.UserID used as CreatedBy / ModifiedBy on ARM history writes.
TROUBLESHOOTER_AUDIT_USER_ID=

# Set to 1 to allow gated writes (assign role, grant/revoke tabs, unlock).
# Ignored when NODE_ENV=production while local-only auth is the only provider.
TROUBLESHOOTER_WRITES_ENABLED=0
# Writes are also limited to these cookie-selected environments. Replica stays read-only.
TROUBLESHOOTER_WRITES_ENVS=DEV,QA,UAT

# Comma-separated environments shown in the switcher. Only names with a
# complete TROUBLESHOOTER_DB_{ENV}_* block (or unprefixed DEV fallback) appear.
TROUBLESHOOTER_ENVS=DEV,QA,UAT,REPLICA
TROUBLESHOOTER_DEFAULT_ENV=DEV

# Unprefixed TROUBLESHOOTER_DB_* is the DEV fallback when prefixed DEV vars
# are unset. Copy host/database/user/password from Core API dbSettings.{ENV}.json.
# Leave _PORT empty for named instances (do not force 1433).

TROUBLESHOOTER_DB_DEV_CONNECTION_STRING=
TROUBLESHOOTER_DB_DEV_HOST=localhost
TROUBLESHOOTER_DB_DEV_PORT=1433
TROUBLESHOOTER_DB_DEV_DATABASE=
TROUBLESHOOTER_DB_DEV_USER=
TROUBLESHOOTER_DB_DEV_PASSWORD=
TROUBLESHOOTER_DB_DEV_ENCRYPT=false
TROUBLESHOOTER_DB_DEV_TRUST_SERVER_CERTIFICATE=true

TROUBLESHOOTER_DB_QA_HOST=
TROUBLESHOOTER_DB_QA_PORT=1433
TROUBLESHOOTER_DB_QA_DATABASE=
TROUBLESHOOTER_DB_QA_USER=
TROUBLESHOOTER_DB_QA_PASSWORD=
TROUBLESHOOTER_DB_QA_ENCRYPT=false
TROUBLESHOOTER_DB_QA_TRUST_SERVER_CERTIFICATE=true

TROUBLESHOOTER_DB_UAT_HOST=
TROUBLESHOOTER_DB_UAT_PORT=
TROUBLESHOOTER_DB_UAT_DATABASE=
TROUBLESHOOTER_DB_UAT_USER=
TROUBLESHOOTER_DB_UAT_PASSWORD=
TROUBLESHOOTER_DB_UAT_ENCRYPT=false
TROUBLESHOOTER_DB_UAT_TRUST_SERVER_CERTIFICATE=true

# Read-only copy of production (HRM-CL-Prod-Replica). Keep out of TROUBLESHOOTER_WRITES_ENVS.
TROUBLESHOOTER_DB_REPLICA_HOST=
TROUBLESHOOTER_DB_REPLICA_PORT=1433
TROUBLESHOOTER_DB_REPLICA_DATABASE=
TROUBLESHOOTER_DB_REPLICA_USER=
TROUBLESHOOTER_DB_REPLICA_PASSWORD=
TROUBLESHOOTER_DB_REPLICA_ENCRYPT=false
TROUBLESHOOTER_DB_REPLICA_TRUST_SERVER_CERTIFICATE=true
