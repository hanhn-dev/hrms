{
  "name": "@hrms/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./module-name-search": {
      "types": "./src/dbs/module-name-search.ts",
      "default": "./src/dbs/module-name-search.ts"
    },
    "./data-fix": {
      "types": "./src/employer/data-fix/guards.ts",
      "default": "./src/employer/data-fix/guards.ts"
    },
    "./tree": {
      "types": "./src/employee/access/tree.ts",
      "default": "./src/employee/access/tree.ts"
    },
    "./menu-tree": {
      "types": "./src/employer/menu/tree.ts",
      "default": "./src/employer/menu/tree.ts"
    },
    "./ids": {
      "types": "./src/shared/ids.ts",
      "default": "./src/shared/ids.ts"
    },
    "./page": {
      "types": "./src/shared/page.ts",
      "default": "./src/shared/page.ts"
    },
    "./org-unit-tree": {
      "types": "./src/employer/roles/org-unit-tree.ts",
      "default": "./src/employer/roles/org-unit-tree.ts"
    },
    "./validation-rule": {
      "types": "./src/employer/fields/validation-rule.ts",
      "default": "./src/employer/fields/validation-rule.ts"
    },
    "./public-fields": {
      "types": "./src/employer/fields/public-fields.ts",
      "default": "./src/employer/fields/public-fields.ts"
    },
    "./uploads": {
      "types": "./src/employer/uploads/classify.ts",
      "default": "./src/employer/uploads/classify.ts"
    },
    "./notifications": {
      "types": "./src/employer/notifications/status.ts",
      "default": "./src/employer/notifications/status.ts"
    },
    "./logs": {
      "types": "./src/employer/logs/pure.ts",
      "default": "./src/employer/logs/pure.ts"
    },
    "./workflow-tree": {
      "types": "./src/employer/workflows/tree.ts",
      "default": "./src/employer/workflows/tree.ts"
    },
    "./settings-catalog": {
      "types": "./src/employer/settings/catalog.ts",
      "default": "./src/employer/settings/catalog.ts"
    },
    "./sections-registry": {
      "types": "./src/employee/sections/record-registry.ts",
      "default": "./src/employee/sections/record-registry.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc",
    "lint": "prisma generate && tsc --noEmit",
    "test": "node ./scripts/run-vitest.mjs run",
    "test:watch": "node ./scripts/run-vitest.mjs"
  },
  "dependencies": {
    "@prisma/adapter-mssql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hrms/typescript-config": "*",
    "@types/node": "^26.1.2",
    "prisma": "^7.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
